{
  "manifest_version": 2,
  "name": "Ổ mềm - Drive",
  "version": "1.0",
  "description": "Dọn giao diện Google Drive và tự bấm Tải tệp lên cho Ổ mềm",
  "browser_specific_settings": { "gecko": { "id": "dmdrive@desktopmini.launcher" } },
  "content_scripts": [
    { "matches": ["https://drive.google.com/*"], "js": ["drive.js"], "run_at": "document_idle" }
  ]
}
